{
  "name": "ir-proxy",
  "version": "1.0.0",
  "description": "Modular proxy server with intercepting mocks, grouped dashboard, and CLI control.",
  "main": "server.js",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "mock": "node scripts/cli.js",
    "mock:help": "node scripts/cli.js --help",
    "mock:health": "node scripts/cli.js health",
    "mock:status": "node scripts/cli.js status",
    "mock:list": "node scripts/cli.js list",
    "mock:blocks": "node scripts/cli.js blocks",
    "mock:run": "node scripts/cli.js run",
    "mock:checks": "node scripts/cli.js checks",
    "mock:profiles": "node scripts/cli.js profiles",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.test.mjs"
    ],
    "moduleFileExtensions": [
      "js",
      "mjs",
      "json"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "body-parser": "^2.2.2",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2"
  }
}
